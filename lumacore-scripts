#!/usr/bin/env bash
# Root entrypoint for the script launcher TUI (Unix).
# On Windows, use lumacore-scripts.ps1 instead.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"
source "$HOME/.cargo/env" 2>/dev/null || true

PROFILE="debug"
BIN="./target/debug/lumacore-scripts"
BUILD_ARGS=()

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
LumaCore scripts launcher

Usage:
  ./lumacore-scripts
  ./lumacore-scripts --release

This launches the ratatui menu for the canonical scripts.
  Unix scripts:   scripts/unix/
  Windows scripts: scripts/win/
The launcher builds the matching workspace binary in target/ if needed.
EOF
    exit 0
fi

if [ "${1:-}" = "--release" ]; then
    PROFILE="release"
    BIN="./target/release/lumacore-scripts"
    BUILD_ARGS=(--release)
    shift
fi

if [ ! -x "$BIN" ]; then
    echo "Building lumacore-scripts ($PROFILE)..."
    # Bash 3.2 (macOS) calls an empty array unbound under `set -u`: expand it only when set.
    cargo build ${BUILD_ARGS[@]+"${BUILD_ARGS[@]}"} -p lumacore-scripts \
        2>&1 | grep -E "^(   Compiling lumacore|    Finished|error)" || true
fi

if [ ! -x "$BIN" ]; then
    echo "Failed to build $BIN" >&2
    exit 1
fi

exec "$BIN" "$@"
