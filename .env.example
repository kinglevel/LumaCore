# LumaCore — Developer Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and set your own paths:
#
#   cp .env.example .env.local
#
# .env.local is gitignored — it will never be committed.
# The dev_init scripts read .env.local and validate the paths.
#
# Format: NAME=path  (absolute or relative to repo root)
# Lines starting with # are comments.

# SKILL — your own companion workspace (reference repos, research notes)
# Optional; LumaCore builds and runs without it.
# SKILL=../my-reference-workspace
