#!/usr/bin/env bash
# Smoke test: start server, connect meownitor, verify startup, clean shutdown.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
SHIP=1  # the smoke test checks the shipped (full release) build
lc_profile 0
TIMEOUT=10

echo "=== LumaCore Smoke Test ==="

# 1. Build (the shared feature set, so the release server keeps its web UI)
{ build_server && build_cli; } || { echo "FAIL: build failed"; exit 1; }

if [ -n "$(server_pids)" ]; then
    echo "FAIL: a lumacore-server is already running (./scripts/unix/server stop)"
    exit 1
fi

# 2. Start server in background, capture stderr (sysmon output)
SYSMON_LOG=$(mktemp)
$SERVER_BIN --show demo --RootMonitor 2>"$SYSMON_LOG" &
SERVER_PID=$!
trap "kill $SERVER_PID 2>/dev/null; rm -f $SYSMON_LOG" EXIT

# 3. Wait for health
echo "Waiting for server to become healthy..."
for i in $(seq 1 $TIMEOUT); do
    if $CLI_BIN --health >/dev/null 2>&1; then break; fi
    if [ "$i" -eq "$TIMEOUT" ]; then
        echo "FAIL: Server did not become healthy"
        cat "$SYSMON_LOG"
        exit 1
    fi
    sleep 0.5
done

echo "Server is healthy."

# 4. Verify sysmon startup lines exist
EXPECTED=("Server : LumaCore server" "Network : UDP command listener" \
          "Network : TCP shell listener" "Server ready")
for pattern in "${EXPECTED[@]}"; do
    if ! grep -q "$pattern" "$SYSMON_LOG"; then
        echo "FAIL: Missing sysmon line: $pattern"
        cat "$SYSMON_LOG"
        exit 1
    fi
done

echo "Startup sysmon lines verified."

# 5. Clean shutdown
$CLI_BIN --shutdown >/dev/null 2>&1 || true
sleep 1
if kill -0 $SERVER_PID 2>/dev/null; then
    echo "FAIL: Server still running after shutdown"
    exit 1
fi

echo "Server shut down successfully."

# 6. Verify shutdown lines
if ! grep -q "Shutdown" "$SYSMON_LOG"; then
    echo "FAIL: Missing shutdown sysmon output"
    cat "$SYSMON_LOG"
    exit 1
fi

echo ""
echo "PASS: Smoke test passed"
echo ""
echo "--- SYSMON output ---"
cat "$SYSMON_LOG"
